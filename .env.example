# Copia este archivo a ".env" y llena los valores. ".env" está en .gitignore: nunca lo subas.

# Neon: conexión directa (migraciones) y pooler (la app)
DATABASE_URL=""
DATABASE_URL_POOLED=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Tests: Postgres local de docker compose (`pnpm db:test:up`), nunca Neon
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5435/chess_test"
