{
  "name": "chess-puzzle-creator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "node --env-file-if-exists=.env --import tsx --test --test-concurrency=3 \"src/**/*.test.ts\" \"test/**/*.test.ts\"",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:test:up": "docker compose up -d",
    "reset-password": "node --env-file-if-exists=.env --import tsx scripts/reset-password.ts",
    "build:openings": "node --import tsx scripts/build-openings.ts",
    "build:sounds": "node --import tsx scripts/build-sounds.ts"
  },
  "dependencies": {
    "@serwist/next": "^9.5.13",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@tanstack/react-query": "^5.69.0",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "better-auth": "^1.7.10",
    "chess.js": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "^15.2.3",
    "postgres": "^3.4.4",
    "react": "^19.0.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "stockfish": "^19.0.1",
    "superjson": "^2.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.3",
    "serwist": "^9.5.13",
    "tailwindcss": "^4.0.15",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "packageManager": "pnpm@11.10.0"
}
